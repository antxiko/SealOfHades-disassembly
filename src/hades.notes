L 0xAC06 boca_dibujo               En el mapa, y el enemigo
C 0xAC17 el tipo 0x0D
L 0xAC1A corazon_sale              El objeto 0x0A: por debajo de la Y 0x10, saca el enemigo 0x0A (el corazon que baja) y se va
C 0xAC25 el tipo 0x0A
L 0xAC2E enemigo_hueco             El tipo C en el primer hueco libre de los enemigos (0xE384, ocho, de 32 en 32); C: puesto
L 0xAC36 enemigo_hueco_uno         Libre?
L 0xAC3F enemigo_hueco_pon         Puesto
L 0xAC42 nada_baja                 Los objetos 0x0B-0x0F: nada; por debajo de 0x80, fuera
L 0xAC50 enemigos_salen            Los enemigos que salen solos: cada 0x20 - escena x 4 + 0-0x1F cuadros (0xE199), uno en un hueco libre: el de la tabla de 0xACB6 por escena y pantalla; desde la pantalla 8, el 8 (el 5 en las escenas 3 y 5)
C 0xAC50 esperando?
C 0xAC56 un cuadro menos
C 0xAC62 la escena x 4...
C 0xAC6C ...0x20 menos eso, + 0-0x1F
C 0xAC74 un hueco
L 0xAC84 enemigos_salen_pon        Desde la pantalla 8, el 8 (y en las escenas impares desde la 3, el 5)
L 0xAC99 enemigos_salen_tabla      El tipo de la tabla de la escena (0xACB6), por la pantalla (0xE053)
D 0xACB6 0xAD00 enemigos_salen_tabla_d Las tablas de los enemigos que salen solos: seis punteros (uno por escena) y diez tipos por escena (uno por pantalla)
D 0xAD00 0xAD36 musicas           Las 9 musicas: las piezas de los canales A, B y C (6 bytes cada una; la 0, nada)
D 0xAD36 0xAD42 efectos_a         Los 6 efectos del canal A: su pieza (2 bytes)
D 0xAD42 0xAD5E efectos_bc        Los 7 efectos de los canales B y C: sus dos piezas (4 bytes); del 3 al 6, el fondo de las escenas
D 0xB033 0xB041 duraciones        Las duraciones de las notas (la mitad alta del byte, 0-13)
D 0x4000 0x4010 cabecera           La cabecera del cartucho: "AB", INIT 0x4010, sin STATEMENT, DEVICE ni TEXT; la demostracion lee sus mandos desde aqui (0x4000), como si fuera su lista
D 0x4066 0x4068 sobra_4066        0x4068 (la direccion de la tabla de detras): nadie lo lee
D 0x4068 0x4074 escenas           Las tablas de pantallas de las seis escenas (0xE050), de la 0 a la 5: 0x40E2, 0x40CC, 0x40B6, 0x40A0, 0x408A y 0x4074
D 0x4074 0x40F8 pantallas         Las pantallas de cada escena: once punteros (0-10, por 0xE053); la escena 5 repite la mayoria de las de la 1
D 0x40F8 0x49B6 pantallas_desc    Las descripciones de las pantallas: el juego de casillas, rectangulos, rellenos de cuatro, el borde (0xFF, 1 o 2), dibujos (sitio y puntero) y objetos (tipo, fila, columna y dibujo), cada lista con su 0xFF
D 0x49B6 0x4A00 bordes            Los dos bordes (0x49B6 y 0x49DB): dibujos (sitio y puntero) hasta 0xFF
D 0x4A00 0x4EAC dibujos           Los dibujos de casillas de las pantallas (ancho, alto y casillas): los de las descripciones y, desde el codigo, la pieza del guardian (0x4A90 y 0x4DE8; rota, 0x4E4A) y la boca (0x4D19 y 0x4D2B)
D 0x4EAC 0x5000 fuente_sobra      340 bytes que nadie lee: el final de una fuente de letras de 8 x 8 (cifras y signos) y ceros
D 0x5000 0x5300 titulo_dibujos    Los dibujos de las casillas 0x30-0x8F del titulo
D 0x5300 0x5780 casillas_dibujos  Los dibujos de las casillas del juego: 0x5300 (0x30-0x7F), 0x5380 (0x40-0x6F), 0x5500 (0x70-0x7F) y 0x5580 (0x40-0x7F), que se solapan
D 0x5780 0x5800 sobra_5780        128 bytes (8 de dibujo y ceros) que nadie lee
D 0x5800 0x5B00 titulo_colores    Los colores de las casillas 0x30-0x8F del titulo
D 0x5B00 0x5F80 casillas_colores  Sus colores: 0x5B00, 0x5B80, 0x5D00 y 0x5D80; 0x5B80 tambien son los dibujos de los sprites de la pausa (0x100 bytes)
D 0x5F80 0x6000 sobra_5f80        128 bytes (0xFF, 0xFE... 0xF0) que nadie lee
D 0x6000 0x8000 casillas_juegos   Los otros juegos de casillas 0x80-0xFF (0xE1BE): dibujos en 0x6000, 0x6400, 0x7000 y 0x7400 y colores en 0x6800, 0x6C00, 0x7800 y 0x7C00; las letras (0x7D00, 0x180 bytes) estan dentro de los ultimos colores: los mismos bytes sirven para las dos cosas
D 0x880F 0x8812 sobra_880f        3 bytes que nadie ejecuta (call WRTVRM detras de un jp); sin uso por lectura estatica y por la medida de cobertura
D 0x885E 0x8870 sobra_885e        18 bytes de codigo que nadie ejecuta (POWER - 1 con el sonido 4); ningun salto llega y la medida de cobertura no pasa
D 0x8890 0x8895 sobra_8890        5 bytes que nadie ejecuta (el sonido 4)
D 0x8948 0x8953 sobra_8948        11 bytes de codigo que nadie ejecuta (0xE500 a cero)
D 0x8D74 0x8D8E casio_filas       Las filas de CASIO de la presentacion
D 0x8D8E 0x8DCE nombre_titulo     El nombre del titulo: 闇の竜王 (8 + 8 casillas) y ハデスの紋章 (16 + 16 + 16)
D 0x8DCE 0x8DD4 sobra_energy      ENERGY: nadie lo apunta
D 0x8DD4 0x8DDC marcador_textos   POWER y AIR
D 0x8DDC 0x8DE1 sobra_over        " OVER": nadie lo apunta
D 0x8DE1 0x8DF1 titulo_txt        GAME START y CASIO (las casillas 0x8A-0x8F)
D 0x8DF1 0x8E04 sobra_stone       THE STONE OF WISDOM: el texto del juego anterior, que nadie apunta (INIT busca el de Stone of Wisdom en otro cartucho, no este)
D 0x8E04 0x8E2E titulo_textos2    PUSH TRIG:1 OR SPACE y COPYRIGHT 1986 (c) CASIO
D 0x8E2E 0x8E36 hiscore           HISCORE: (se copian 7; SCORE, 0x8E30, es su final)
D 0x8E36 0x8E3F game_over_txt     GAME OVER
D 0x8E3F 0x8E46 sobra_power       "T;POWER": nadie lo apunta
D 0x8E46 0x8E50 leon_scene        LEON y SCENE
D 0x8E50 0x8EBB final_texto       El texto del final (16, 16, 14, 18, 5, 18 y 20 casillas; las letras de la BIOS con su numero: hiragana 0x86-0x9F y 0xE0-0xFD, katakana 0xA1-0xDF): "わたしは ほしのめがみ エーメ / やみのりゅうおうは さりました / あなたの ゆうきを たたえて / ひかりのしょうごうを さずけます / イルシオン / いつのひにか あなたは もういちど / そのゆうきを ためされるでしょう..."
D 0x8F41 0x8F47 sobra_8f41        6 bytes que nadie ejecuta (ld hl,0xE600...)
D 0x8F7C 0x8F90 espacios          20 espacios: la fila en blanco de la presentacion
D 0x8FBD 0x9000 sobra_8fbd        67 bytes que nadie lee: un jp, "ER    T;MORIYAMA" (un resto de unos creditos) y espacios
D 0x9000 0x9800 sprites           Los dibujos de los 64 sprites de 16 x 16 (0x800 bytes, a 0x3800)
D 0x9800 0x9801 sobra_9800        Un "ret" que nadie ejecuta
D 0xB13C 0xC000 piezas            Las piezas de las musicas y los efectos (los punteros de 0xAD00-0xAD5D): notas, ruidos y ordenes 0xF0-0xFF; al final, el relleno FB 00 de la EPROM, que nadie lee
